{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-invitation-app",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding-invitations-db",
      "database_id": "785751e5-9b3e-4f69-99d8-0b1c368c6593"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "wedding-invitations-assets"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "ec683add06244fab95a470a8d81863d5"
    }
  ]
}

