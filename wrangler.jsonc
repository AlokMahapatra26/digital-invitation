{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-invitation-app",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding-invitations-db",
      "database_id": "local-wedding-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "wedding-invitations-assets"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "wedding-cache"
    }
  ]
}
